ADMIN_PASSWORD="cambiar-por-una-contrasena-segura"

# Supabase Storage
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cambiar-por-service-role-key"
SUPABASE_BUCKET="autos"

# Cloudflare R2 Storage - preferred for car images when configured
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="boulevard-automoviles"
